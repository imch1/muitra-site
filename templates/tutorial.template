  <main id="top">
    <section class="tut-hero">
      <p class="eyebrow" data-i18n="tut.eyebrow">The quick tour</p>
      <h1 class="tut-title" data-i18n="tut.title">How Muitra works</h1>
      <p class="tut-sub" data-i18n="tut.sub">A shared home runs on small habits. Here's the whole idea in seven short steps.</p>
    </section>

    <div class="tut-steps">
      <!-- 1 intro -->
      <article class="step">
        <div class="step-text">
          <span class="step-num">1</span>
          <span class="step-emoji">🏠</span>
          <h2 data-i18n="tutorial.intro_title">A shared home, one list.</h2>
          <p data-i18n="tutorial.intro_body">In Muitra, tasks take turns between everyone at home. Here's the quick tour.</p>
        </div>
        <figure class="step-shot"><img id="t1" alt="" loading="lazy" /></figure>
      </article>

      <!-- 2 turns -->
      <article class="step">
        <div class="step-text">
          <span class="step-num">2</span>
          <span class="step-emoji">✅</span>
          <h2 data-i18n="tutorial.turns_title">Whose turn?</h2>
          <p data-i18n="tutorial.turns_body">Today shows what's yours. Tap to complete — and the turn passes to whoever's next.</p>
        </div>
        <figure class="step-shot"><img id="t2" alt="" loading="lazy" /></figure>
      </article>

      <!-- 3 plan -->
      <article class="step">
        <div class="step-text">
          <span class="step-num">3</span>
          <span class="step-emoji">➕</span>
          <h2 data-i18n="tutorial.plan_title">Build your rhythm.</h2>
          <p data-i18n="tutorial.plan_body">Tap + to add a task and how often it repeats. Start a custom task's name with an emoji to spot it at a glance in the Calendar.</p>
        </div>
        <figure class="step-shot"><img id="t3" alt="" loading="lazy" /></figure>
      </article>

      <!-- 4 cal -->
      <article class="step">
        <div class="step-text">
          <span class="step-num">4</span>
          <span class="step-emoji">🗓️</span>
          <h2 data-i18n="tutorial.cal_title">Two ways to look ahead.</h2>
          <p data-i18n="tutorial.cal_body">Tap Week for a day-by-day agenda, or Month for the whole picture at a glance — each task colored by who's on it.</p>
        </div>
        <figure class="step-shot"><img id="t4" alt="" loading="lazy" /></figure>
      </article>

      <!-- 5 fair -->
      <article class="step">
        <div class="step-text">
          <span class="step-num">5</span>
          <span class="step-emoji">💜</span>
          <h2 data-i18n="tutorial.fair_title">Always fair.</h2>
          <p data-i18n="tutorial.fair_body">Muitra simply keeps turns balanced — just the two of you, or a whole household, each with their own color.</p>
        </div>
        <figure class="step-shot"><img id="t5" alt="" loading="lazy" /></figure>
      </article>

    </div>

    <section class="badge-guide" id="achievements" aria-labelledby="badge-guide-title">
      <p class="eyebrow" data-i18n="badge.eyebrow">Progress</p>
      <h2 id="badge-guide-title" data-i18n="badge.title">A journey worth celebrating</h2>
      <div class="badge-journey badge-household">
        <h3 data-i18n="badge.shared_title">Your household collection</h3>
        <p class="badge-guide-intro" data-i18n="badge.house_intro">Each shared task moves your household forward.</p>
        <p class="badge-track-label" data-i18n="badge.completion_track">Shared task milestones</p>
        <ol class="badge-timeline" aria-label="Shared task milestones" data-i18n-aria="badge.completion_track">
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/shared_first_step.png" alt="" width="250" height="270" /></span><strong>1</strong><span data-i18n="badge.shared_1">First Shared Step</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/shared_team_warmup.png" alt="" width="250" height="270" /></span><strong>10</strong><span data-i18n="badge.shared_10">Team Warm-Up</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/shared_in_sync.png" alt="" width="250" height="270" /></span><strong>25</strong><span data-i18n="badge.shared_25">In Sync</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/shared_super_team.png" alt="" width="250" height="270" /></span><strong>100</strong><span data-i18n="badge.shared_100">Super Team</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/shared_home_champions.png" alt="" width="250" height="270" /></span><strong>500</strong><span data-i18n="badge.shared_500">Home Champions</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/shared_household_legends.png" alt="" width="250" height="270" /></span><strong data-i18n="badge.milestone_1000">1,000</strong><span data-i18n="badge.shared_1000">Household Legends</span></li>
        </ol>
        <p class="badge-track-hint" data-i18n="badge.track_hint">Swipe to explore the milestones</p>
        <div class="badge-rhythm"><span class="badge-rhythm-art" aria-hidden="true"><img src="/assets/progress/badges/shared_first_week_together.png" alt="" width="250" height="270" /><img src="/assets/progress/badges/shared_finding_our_rhythm.png" alt="" width="250" height="270" /><img src="/assets/progress/badges/shared_steady_team.png" alt="" width="250" height="270" /><img src="/assets/progress/badges/shared_keepers_of_home.png" alt="" width="250" height="270" /><img src="/assets/progress/badges/shared_home_legends.png" alt="" width="250" height="270" /></span><span data-i18n="badge.house_rhythm">Rhythm badges: 1 · 4 · 13 · 26 · 52 balanced weeks</span></div>
        <div class="badge-formula" aria-label="Balanced week" data-i18n-aria="badge.balanced_title">
          <span data-i18n="badge.balanced_title">A balanced week</span>
          <strong>4 <small data-i18n="badge.tasks">tasks</small></strong>
          <b aria-hidden="true">+</b>
          <strong>2 <small data-i18n="badge.people">people</small></strong>
          <b aria-hidden="true">+</b>
          <strong>≤70% <small data-i18n="badge.max_share">each</small></strong>
        </div>
        <details class="badge-rules">
          <summary data-i18n="badge.exact_rules">See exact rules</summary>
          <p data-i18n="badge.shared_body">Shared progress begins when a second member joins. Eligible shared completions count once for the household.</p>
          <p data-i18n="badge.balanced_body">A balanced week has four shared tasks and two contributors, with no one doing more than 70%.</p>
        </details>
      </div>
      <div class="badge-journey badge-solo">
        <h3 data-i18n="badge.solo_title">Your solo chapter</h3>
        <p class="badge-guide-intro" data-i18n="badge.solo_intro">Every completed task builds your own rhythm.</p>
        <p class="badge-track-label" data-i18n="badge.solo_track">Personal task milestones</p>
        <ol class="badge-timeline" aria-label="Personal task milestones" data-i18n-aria="badge.solo_track">
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/solo_first_spark.png" alt="" width="250" height="270" /></span><strong>1</strong><span data-i18n="badge.solo_1">First Spark</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/solo_finding_your_flow.png" alt="" width="250" height="270" /></span><strong>10</strong><span data-i18n="badge.solo_10">Finding Your Flow</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/solo_on_a_roll.png" alt="" width="250" height="270" /></span><strong>25</strong><span data-i18n="badge.solo_25">On a Roll</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/solo_home_hero.png" alt="" width="250" height="270" /></span><strong>100</strong><span data-i18n="badge.solo_100">Home Hero</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/solo_task_titan.png" alt="" width="250" height="270" /></span><strong>500</strong><span data-i18n="badge.solo_500">Task Titan</span></li>
          <li><span class="badge-medallion" aria-hidden="true"><img src="/assets/progress/badges/solo_mega_maker.png" alt="" width="250" height="270" /></span><strong data-i18n="badge.milestone_1000">1,000</strong><span data-i18n="badge.solo_1000">Mega Maker</span></li>
        </ol>
        <p class="badge-track-hint" data-i18n="badge.track_hint">Swipe to explore the milestones</p>
        <div class="badge-rhythm"><span class="badge-rhythm-art" aria-hidden="true"><img src="/assets/progress/badges/solo_own_rhythm.png" alt="" width="250" height="270" /><img src="/assets/progress/badges/solo_steady_hand.png" alt="" width="250" height="270" /><img src="/assets/progress/badges/solo_space_keeper.png" alt="" width="250" height="270" /><img src="/assets/progress/badges/solo_master_of_your_space.png" alt="" width="250" height="270" /></span><span data-i18n="badge.solo_rhythm">Rhythm badges: 4 · 13 · 26 · 52 active weeks</span></div>
        <details class="badge-rules">
          <summary data-i18n="badge.exact_rules">See exact rules</summary>
          <p data-i18n="badge.solo_body">Personal tasks completed while you are the only member count toward your solo chapter.</p>
        </details>
      </div>
    </section>

